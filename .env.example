# Copia este archivo como .env (no se sube a git) y llena los valores.
# Tambien puedes definirlas como variables de entorno del sistema o en la configuracion de ejecucion del IDE.

# Base de datos MySQL (se usan tambien para el perfil de pruebas)
DB_USERNAME=
DB_PASSWORD=

# Clave para firmar los tokens JWT (cadena larga y aleatoria)
JWT_SECRET_KEY=

# SendGrid: API key y correo remitente verificado
SENDGRID_API_KEY=
SENDGRID_EMAIL_FROM=
